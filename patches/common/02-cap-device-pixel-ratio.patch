diff --git a/apps/common/mobile/utils/dprCap.js b/apps/common/mobile/utils/dprCap.js
new file mode 100644
index 0000000..d1f4cf8
--- /dev/null
+++ b/apps/common/mobile/utils/dprCap.js
@@ -0,0 +1,17 @@
+/*
+ * Signofile modification: cap window.devicePixelRatio at 2 for the mobile editors.
+ *
+ * The editors draw the document on full-viewport canvases whose backing store is cssSize x devicePixelRatio. On a
+ * 3x phone that is 9/4 of the pixels of a 2x canvas to clear and repaint on every scroll step. The SDK reads
+ * window.devicePixelRatio when it is loaded, so this module has to run first (it is the first import of app.js).
+ * Pages are drawn at 2x and the browser scales them to the device; text is slightly softer than at native 3x.
+ * No effect on screens at 2x or below. This is a modified version of the Program.
+ */
+(function () {
+    try {
+        const real = window.devicePixelRatio || 1;
+        if (real > 2) {
+            Object.defineProperty(window, 'devicePixelRatio', { configurable: true, get: () => 2 });
+        }
+    } catch (e) { /* keep the real value */ }
+})();
